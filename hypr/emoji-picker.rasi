// Emoji picker — gruvbox dark
* {
    bg0:     #282828;  // dark0
    bg1:     #3c3836;  // dark1
    bg2:     #504945;  // dark2
    fg:      #ebdbb2;  // light0
    fg2:     #d5c4a1;  // light2
    gray:    #928374;
    yellow:  #fabd2f;
    red:     #fb4934;
    green:   #b8bb26;
    blue:    #83a598;

    background-color: transparent;
    text-color: @fg;
    font: "JetBrains Mono 12";
}

window {
    location: center;
    width: 560px;
    height: 480px;
    background-color: @bg0;
    border: 2px;
    border-color: #78824b;
    padding: 8px;
}

inputbar {
    spacing: 8px;
    padding: 8px;
    background-color: @bg1;
    text-color: @fg;
    children: [ prompt, entry ];
}

prompt {
    text-color: @yellow;
}

entry {
    text-color: @fg;
    placeholder: "search emoji…";
    placeholder-color: @gray;
}

listview {
    lines: 14;
    columns: 2;
    fixed-columns: true;
    spacing: 2px;
    background-color: transparent;
    scrollbar: true;
}

element {
    padding: 4px 6px;
    background-color: transparent;
    text-color: @fg;
    orientation: horizontal;
    spacing: 8px;
}

element selected {
    background-color: @yellow;
    text-color: @bg0;
}

element-text {
    text-color: inherit;
    vertical-align: 0.5;
}

scrollbar {
    width: 4px;
    handle-color: @bg2;
    background-color: transparent;
}

textbox {
    text-color: @fg2;
}
